# ======================================================
# 🌐 Configuração Geral
# ======================================================

# Liga/desliga modo debug (use False em produção!)
DEBUG=True  

# Chave secreta do Django (use um valor longo e único em produção)
# Gere com: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=change-me

# Hosts permitidos (separados por vírgula)
ALLOWED_HOSTS=127.0.0.1,localhost

# Idioma e fuso horário padrão
LANGUAGE_CODE=pt-br
TIME_ZONE=America/Sao_Paulo

# ======================================================
# 🗄️ Banco de Dados
# ======================================================

# SQLite (dev) → será usado se não definir DATABASE_URL
# PostgreSQL (prod) → troque usuário, senha, host, porta e database
# DATABASE_URL=postgres://user:pass@localhost:5432/miele_dev

# ======================================================
# 🔑 Autenticação & JWT
# ======================================================

# Tempo de expiração do access token (minutos)
SIMPLEJWT_ACCESS_MIN=15

# Tempo de expiração do refresh token (dias)
SIMPLEJWT_REFRESH_DAYS=14

# ======================================================
# 🌍 CORS / Segurança
# ======================================================

# Permitir qualquer origem (apenas dev; em prod use origens específicas)
CORS_ALLOW_ALL_ORIGINS=True  

# Ou defina explicitamente as origens permitidas (separadas por vírgula)
CORS_ALLOWED_ORIGINS=

# ======================================================
# 📧 E-mail (SMTP / Anymail) - NÃO IMPLEMENTADO NO MVP
# ======================================================

# Configuração de email não implementada no MVP
# Para versões futuras, descomentar e configurar:

# Configuração SMTP simples
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=seu_email@example.com
EMAIL_HOST_PASSWORD=sua_senha_ou_app_password
DEFAULT_FROM_EMAIL="Miele System <no-reply@miele-system.com>"

# (Opcional) Anymail / Sendgrid, Amazon SES, etc.
# ANYMAIL_PROVIDER_API_KEY=chave-api-aqui

# ======================================================
# ☁️ Google Drive Integration
# ======================================================

# ID do cliente OAuth2 da aplicação (para acesso delegado)
# Encontre na Google Cloud Console > APIs & Services > Credentials > OAuth 2.0 Client IDs
GDRIVE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# Segredo do cliente OAuth2 da aplicação
GDRIVE_CLIENT_SECRET=your-client-secret

# ID da pasta raiz para arquivos de clientes no Google Drive
# Crie uma pasta "Miele-Clients" no Drive e pegue o ID da URL
GDRIVE_CLIENTS_FOLDER_ID=1BxiMVs0XRA5nFMdKvBdBZjgmUUqptlWC

# ID da pasta raiz para arquivos de PER/DCOMPs no Google Drive  
# Crie uma pasta "Miele-PERDCOMPs" no Drive e pegue o ID da URL
GDRIVE_PERDCOMPS_FOLDER_ID=1CxiMVs0XRA5nFMdKvBdBZjgmUUqptlWD

# Token de refresh OAuth2 (necessário para acesso delegado)
GDRIVE_REFRESH_TOKEN=seu_refresh_token_aqui

# Tamanho máximo de arquivo em bytes (padrão: 100MB)
GDRIVE_MAX_FILE_SIZE=104857600

# Timeout para operações da API do Google Drive em segundos
GDRIVE_API_TIMEOUT=30

# Rate limit - requests por minuto para a API do Google Drive
GDRIVE_REQUESTS_PER_MINUTE=600

# Intervalo de verificação de sincronização em horas
GDRIVE_SYNC_VERIFICATION_INTERVAL=24
