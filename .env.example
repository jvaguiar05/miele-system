# ======================================================
# 🌐 Configuração Geral
# ======================================================

# Liga/desliga modo debug (use False em produção!)
DEBUG=True  

# Chave secreta do Django (use um valor longo e único em produção)
# Gere com: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=change-me

# Hosts permitidos (separados por vírgula)
ALLOWED_HOSTS=127.0.0.1,localhost

# Idioma e fuso horário padrão
LANGUAGE_CODE=pt-br
TIME_ZONE=America/Sao_Paulo

# ======================================================
# 🗄️ Banco de Dados
# ======================================================

# SQLite (dev) → será usado se não definir DATABASE_URL
# PostgreSQL (prod) → troque usuário, senha, host, porta e database
# DATABASE_URL=postgres://user:pass@localhost:5432/miele_dev

# ======================================================
# 🔑 Autenticação & JWT
# ======================================================

# Tempo de expiração do access token (minutos)
SIMPLEJWT_ACCESS_MIN=15

# Tempo de expiração do refresh token (dias)
SIMPLEJWT_REFRESH_DAYS=14

# ======================================================
# 🌍 CORS / Segurança
# ======================================================

# Permitir qualquer origem (apenas dev; em prod use origens específicas)
CORS_ALLOW_ALL_ORIGINS=True  

# Ou defina explicitamente as origens permitidas (separadas por vírgula)
CORS_ALLOWED_ORIGINS=

# ======================================================
# 📦 Redis (Cache / Celery)
# ======================================================

# URL do Redis (necessário para Celery, rate limit e cache)
REDIS_URL=redis://localhost:6379/0

# ======================================================
# 📧 E-mail (SMTP / Anymail)
# ======================================================

# Configuração SMTP simples
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=seu_email@example.com
EMAIL_HOST_PASSWORD=sua_senha_ou_app_password
DEFAULT_FROM_EMAIL="Miele System <no-reply@miele-system.com>"

# (Opcional) Anymail / Sendgrid, Amazon SES, etc.
# ANYMAIL_PROVIDER_API_KEY=chave-api-aqui

# ======================================================
# ☁️ Storage (Arquivos / Anexos)
# ======================================================

# Backend de storage (local em dev, s3 em prod)
STORAGE_BACKEND=local  

# Local (dev)
MEDIA_ROOT=./media
STATIC_ROOT=./staticfiles

# AWS S3 (prod)
AWS_STORAGE_BUCKET_NAME=miele-system-bucket
AWS_S3_REGION_NAME=us-east-1
AWS_ACCESS_KEY_ID=CHAVE_AWS_AQUI
AWS_SECRET_ACCESS_KEY=SEGREDO_AWS_AQUI

# ======================================================
# 🕵️ Observabilidade / Logs
# ======================================================

# DSN do Sentry (deixe vazio se não for usar em dev)
SENTRY_DSN=

# Nível de log (INFO, DEBUG, WARNING, ERROR)
LOG_LEVEL=INFO
